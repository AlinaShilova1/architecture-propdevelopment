{
  "name": "k8s-rbac-lab",
  "image": "mcr.microsoft.com/devcontainers/base:noble",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},              // DinD
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {}          // kubectl/helm/minikube
  },
  "runArgs": ["--privileged"],                                            // нужно для DinD
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/init.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-kubernetes-tools.vscode-kubernetes-tools"]
    }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" }
}